# 파랜드 택틱스 3 — RGB30(스틱 있음) gptokeyb 매핑
# 마우스 중심 게임: 왼쪽 스틱 = 커서, A/L1 = 좌클릭, B/R1 = 우클릭
# gptokeyb: left_analog_up 에 mouse_movement_up 을 주면 스틱→마우스 모드가 켜진다
back = esc
start = enter
a = mouse_left
b = mouse_right
x = enter
y = esc
l1 = mouse_left
r1 = mouse_right
l2 = f12
r2 = space
l3 = mouse_left
r3 = mouse_right

left_analog_up = mouse_movement_up
mouse_scale = 200
mouse_delay = 10

hotkey = back

